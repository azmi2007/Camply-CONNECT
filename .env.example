# CAMPLY Environment Configuration
# Copy this file to .env.local for local overrides

VITE_APP_NAME=CAMPLY
VITE_APP_SLOGAN="Your Campus. Your People. Your Future."
VITE_APP_URL=http://localhost:5173

# Supabase Configuration
# CAMPLY is equipped with a full mock fallback store, so the platform is 100% functional
# out of the box even without active Supabase credentials!
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional OAuth / Analytics
VITE_ENABLE_ANALYTICS=true

